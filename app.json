{
  "expo": {
    "name": "Lumi",
    "slug": "lumi-camera",
    "scheme": "lumi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4EF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lumi.camera",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lumi.camera",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumi가 사진을 촬영하려면 카메라 접근 권한이 필요해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lumi에서 편집할 사진을 불러오기 위해 사진 보관함 접근 권한이 필요해요.",
          "savePhotosPermission": "편집한 사진을 사진 보관함에 저장하기 위해 권한이 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumi에서 편집할 사진을 선택하기 위해 사진 보관함 접근 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "‘위치 정보 저장’을 켜면 촬영한 사진에 위치를 기록하기 위해 사용해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F7F4EF"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
